; Engine configuration file.
config_version=5

[application]

config/name="Fortnite Temu Edition"
config/description="Low-poly third-person battle royale: 100 players, building, storm."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[autoload]

Cfg="*res://scripts/core/cfg.gd"
Sfx="*res://scripts/core/sfx.gd"
Fx="*res://scripts/core/fx.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="vulkan"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.95, 1)
textures/canvas_textures/default_texture_filter=1
